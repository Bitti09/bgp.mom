---
import { Image } from "astro:assets";
import ExpandableNotes from "./ExpandableNotes.tsx";
import type { BGPProvider } from "../utils/types";
import {
  getCurrencySymbol,
  getTableTypeText,
  parseLocation,
} from "../utils/types";

interface Props extends BGPProvider {}

const {
  title,
  image,
  asn,
  tableType = "full",
  locations = [],
  services = [],
  features = [],
  rpkiStatus,
  prefixUpdateStatus,
  loaRequired,
  notes,
  bgpFee,
  pricing,
  currency = "USD",
  url,
} = Astro.props;

const tableTypeText = getTableTypeText(tableType);
const currencySymbol = getCurrencySymbol(currency);
const pricingHasExplicitSuffix = /\/\s*[a-z]+/i.test(pricing);
const pricingSuffix = pricingHasExplicitSuffix ? "" : "/mo";
const noteLines = notes
  ? notes
      .trim()
      .split("\n")
      .filter((l) => l !== "")
  : [];
---

<div class="card bg-base-200 h-full w-full">
  <div class="card-body flex flex-col h-full p-4 sm:p-6">
    <!-- Card Header -->
    <div class="card-actions justify-between items-center mb-4 gap-2 flex-wrap">
      <!-- ASN Badge - Left -->
      <a
        href={`https://bgp.tools/as/${asn}`}
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event={`${title} bgp.tools visited`}
        data-umami-event-url={`https://bgp.tools/as/${asn}`}
        class="btn btn-sm bg-base-100 hover:bg-base-300 border-base-300 transition-colors px-2 min-h-0 h-8 font-mono text-base-content/80"
      >
        AS{asn}
      </a>

      <!-- Table Type - Middle -->
      <button class="btn btn-sm btn-soft no-animation cursor-default"
        >{tableTypeText}</button
      >

      <!-- Status Badges - Right -->
      <div class="flex items-center gap-2">
        {
          rpkiStatus && (
            <div
              class={`tooltip tooltip-bottom ${rpkiStatus === "yes" ? "tooltip-success" : "tooltip-error"}`}
              data-tip={
                rpkiStatus === "yes"
                  ? "RPKI Filtering: Yes"
                  : "RPKI Filtering: No"
              }
            >
              <div
                class={`btn btn-sm btn-square btn-soft cursor-default ${rpkiStatus === "yes" ? "btn-success" : "btn-error"}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>
              </div>
            </div>
          )
        }
        {
          prefixUpdateStatus && (
            <div
              class={`tooltip tooltip-bottom ${prefixUpdateStatus === "automatic" ? "tooltip-success" : "tooltip-error"}`}
              data-tip={
                prefixUpdateStatus === "automatic"
                  ? "Prefix Updates: Automatic"
                  : "Prefix Updates: Manual"
              }
            >
              <div
                class={`btn btn-sm btn-square btn-soft cursor-default ${prefixUpdateStatus === "automatic" ? "btn-success" : "btn-error"}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </div>
            </div>
          )
        }
        {
          loaRequired && (
            <div
              class={`tooltip tooltip-bottom ${loaRequired === "no" ? "tooltip-success" : "tooltip-error"}`}
              data-tip={
                loaRequired === "no" ? "LOA Required: No" : "LOA Required: Yes"
              }
            >
              <div
                class={`btn btn-sm btn-square btn-soft cursor-default ${loaRequired === "no" ? "btn-success" : "btn-error"}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  />
                </svg>
              </div>
            </div>
          )
        }
      </div>
    </div>

    <!-- Content that can grow -->
    <div class="flex-1 flex flex-col justify-between">
      <div>
        <!-- Logo and Company Name -->
        <div class="flex items-center gap-4 mb-4">
          <div
            class="w-12 h-12 rounded-lg bg-base-100 flex items-center justify-center overflow-hidden"
          >
            {
              image ? (
                <Image
                  src={image}
                  alt={`${title} logo`}
                  width={48}
                  height={48}
                  class="max-w-full max-h-full object-contain"
                />
              ) : (
                <div class="text-2xl font-bold text-base-content/20">
                  {title.charAt(0)}
                </div>
              )
            }
          </div>
          <div>
            <h2 class="card-title">{title}</h2>
          </div>
        </div>

        <!-- Locations -->
        {
          locations.length > 0 && (
            <div class="mb-2">
              <h2 class="text-[10px] font-bold uppercase tracking-widest mb-2 text-base-content/50">
                Locations
              </h2>
              <div class="flex flex-wrap gap-2 items-center">
                {locations.map((location) => {
                  const { city, countryCode } = parseLocation(location);
                  return (
                    <div
                      class="badge badge-soft badge-sm"
                      data-key={`location-${location}`}
                    >
                      <span class={`fi fi-${countryCode.toLowerCase()} mr-1`} />
                      {city}
                    </div>
                  );
                })}
              </div>
            </div>
          )
        }

        <!-- Services -->
        {
          services.length > 0 && (
            <div class="mb-2">
              <h2 class="text-[10px] font-bold uppercase tracking-widest mb-2 text-base-content/50">
                Services
              </h2>
              <div class="flex flex-wrap gap-2  items-center">
                {services.map((service) => (
                  <div
                    class="badge badge-soft badge-sm"
                    data-key={`service-${service}`}
                  >
                    {service}
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- Features -->
        {
          features.length > 0 && (
            <div class="mb-2">
              <h2 class="text-[10px] font-bold uppercase tracking-widest mb-2 text-base-content/50">
                Features
              </h2>
              <div class="flex flex-wrap gap-2 items-center">
                {features.map((feature) => (
                  <div
                    class="badge badge-outline border-base-content/20 text-base-content/70 badge-sm"
                    data-key={`feature-${feature}`}
                  >
                    {feature}
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- Notes -->
        {
          noteLines.length > 0 && (
            <div class="mb-2">
              <h2 class="text-[10px] font-bold uppercase tracking-widest mb-1 text-base-content/50">
                Notes
              </h2>
              <ExpandableNotes lines={noteLines} client:load />
            </div>
          )
        }
      </div>

      <!-- Bottom section with pricing and button -->
      <div>
        <!-- Pricing & Fee -->
        <div class="grid grid-cols-2 gap-4 pt-2 mb-4">
          <div>
            <h2
              class="text-[10px] font-bold uppercase tracking-widest mb-2 text-base-content/50"
            >
              BGP Fee
            </h2>
            {
              bgpFee === "0" ? (
                <div class="badge badge-success badge-sm">Free BGP</div>
              ) : (
                <p class="text-base font-bold text-base-content">
                  {currencySymbol}{bgpFee}
                  <span class="text-xs font-normal text-base-content/60 ml-1">{currency}</span>
                </p>
              )
            }
          </div>
          <div>
            <h2
              class="text-[10px] font-bold uppercase tracking-widest mb-2 text-base-content/50"
            >
              Pricing
            </h2>
            <p class="text-base font-bold text-base-content">
              {currencySymbol}{pricing}
              {pricingSuffix && <span class="text-xs font-normal text-base-content/60">{pricingSuffix}</span>}
            </p>
          </div>
        </div>

        <!-- View Button -->
        <div class="card-actions justify-end">
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event={`${title} button clicked`}
            data-umami-event-url={url}
            class="btn btn-primary btn-sm w-full gap-2 shadow-md shadow-primary/20"
          >
            View Provider
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
