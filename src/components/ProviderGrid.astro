---
import Card from "./Card.astro";

interface Props {
  providers: any[];
}

const { providers } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-4 md:gap-6 w-full">
  {
    providers.map((entry) => (
      <div class="min-w-0 h-full">
        <Card {...entry.data} />
      </div>
    ))
  }
</div>
